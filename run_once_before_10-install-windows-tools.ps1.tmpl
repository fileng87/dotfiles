{{- if eq .chezmoi.os "windows" }}
$ErrorActionPreference = 'Stop'

if ($PSVersionTable.PSEdition -eq 'Desktop') {
    $windowsModules = Join-Path $env:WINDIR 'System32\WindowsPowerShell\v1.0\Modules'
    $env:PSModulePath = "$windowsModules;$env:PSModulePath"
}

if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
    $release = Invoke-RestMethod -Uri 'https://api.github.com/repos/git-for-windows/git/releases/latest' -Headers @{ 'User-Agent' = 'chezmoi-bootstrap' }
    $asset = $release.assets | Where-Object { $_.name -like '*-64-bit.exe' } | Select-Object -First 1
    if (-not $asset) {
        throw 'Could not find the Git for Windows 64-bit installer asset'
    }

    $installerPath = Join-Path $env:TEMP $asset.name
    Invoke-WebRequest -Uri $asset.browser_download_url -OutFile $installerPath

    $installerArgs = '/VERYSILENT /NORESTART /NOCANCEL /SP- /CLOSEAPPLICATIONS /RESTARTAPPLICATIONS'
    $installer = Start-Process -FilePath $installerPath -ArgumentList $installerArgs -Wait -PassThru
    Remove-Item -LiteralPath $installerPath -Force -ErrorAction SilentlyContinue

    if ($installer.ExitCode -ne 0) {
        throw "Failed to install Git for Windows (exit code $($installer.ExitCode))"
    }

    $env:PATH = "$env:ProgramFiles\Git\cmd;$env:PATH"
}

if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser -Force
    Invoke-RestMethod -Uri 'https://get.scoop.sh' | Invoke-Expression
}

$apps = @(
    'pwsh',
    'starship',
    'mise',
    'zoxide',
    'lsd',
    'fzf',
    'ripgrep',
    'bat'
)

foreach ($app in $apps) {
    & scoop install $app
    if ($LASTEXITCODE -ne 0) {
        throw "Failed to install Scoop app: $app"
    }
}

$fontDirectory = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
$jetBrainsNerdFont = Get-ChildItem -LiteralPath $fontDirectory -Filter 'JetBrainsMono*NerdFont*.ttf' -ErrorAction SilentlyContinue

if (-not $jetBrainsNerdFont) {
    $nerdFontsBucket = & scoop bucket list | Select-String '^\s*nerd-fonts\s'
    if (-not $nerdFontsBucket) {
        & scoop bucket add nerd-fonts
        if ($LASTEXITCODE -ne 0) {
            throw 'Failed to add the nerd-fonts Scoop bucket'
        }
    }

    & scoop install nerd-fonts/JetBrainsMono-NF
    if ($LASTEXITCODE -ne 0) {
        throw 'Failed to install JetBrainsMono Nerd Font'
    }
}
{{- end }}
