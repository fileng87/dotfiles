{{- if eq .chezmoi.os "linux" }}
#!/bin/sh
set -eu

if [ "$(id -u)" -eq 0 ]; then
    SUDO=''
elif command -v sudo >/dev/null 2>&1; then
    SUDO='sudo'
else
    echo 'sudo is required to install system packages' >&2
    exit 1
fi

if command -v apt-get >/dev/null 2>&1; then
    $SUDO apt-get update
    $SUDO apt-get install -y ca-certificates git curl unzip zsh zoxide lsd fzf ripgrep bat
elif command -v dnf >/dev/null 2>&1; then
    $SUDO dnf install -y ca-certificates git curl unzip zsh zoxide lsd fzf ripgrep bat
elif command -v pacman >/dev/null 2>&1; then
    $SUDO pacman -S --needed --noconfirm ca-certificates git curl unzip zsh starship zoxide lsd fzf ripgrep bat
else
    echo 'Unsupported Linux package manager: expected apt-get, dnf, or pacman' >&2
    exit 1
fi

mkdir -p "$HOME/.local/bin"
export PATH="$HOME/.local/bin:$PATH"

if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then
    ln -sf "$(command -v batcat)" "$HOME/.local/bin/bat"
fi

if ! command -v starship >/dev/null 2>&1; then
    starship_installer=$(mktemp)
    trap 'rm -f "$starship_installer"' EXIT HUP INT TERM
    curl -fsSL https://starship.rs/install.sh -o "$starship_installer"
    sh "$starship_installer" --yes --bin-dir "$HOME/.local/bin"
    rm -f "$starship_installer"
    trap - EXIT HUP INT TERM
fi

if ! command -v mise >/dev/null 2>&1; then
    mise_installer=$(mktemp)
    trap 'rm -f "$mise_installer"' EXIT HUP INT TERM
    curl -fsSL https://mise.run -o "$mise_installer"
    sh "$mise_installer"
    rm -f "$mise_installer"
    trap - EXIT HUP INT TERM
fi
{{- end }}
